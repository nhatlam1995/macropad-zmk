#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Vặn núm xoay: Tăng / Giảm âm lượng
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            bindings = <
                // ---- HÀNG TRÊN (4 phím bình thường để test gõ chữ) ----
                &kp Q        &kp W        &kp E        &kp R        

                // ---- HÀNG DƯỚI (Dành riêng cấu hình Bluetooth & Hệ thống) ----
                &bt BT_SEL 0 // Nút 1 (Cột 1): Kết nối / Chuyển sang Thiết bị Bluetooth số 1
                &bt BT_SEL 1 // Nút 2 (Cột 2): Kết nối / Chuyển sang Thiết bị Bluetooth số 2
                &bt BT_CLR   // Nút 3 (Cột 3): Xóa toàn bộ thiết bị Bluetooth đã lưu (để ghép nối mới)
                &bootloader  // Nút 4 (Cột 4 - Phím núm xoay): Nhấn vào để đưa mạch về chế độ nạp code (Mass Storage)
            >;
        };
    };
};
