#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        // Macro mở Chrome qua hộp thoại Run (Win + R)
        open_chrome: open_chrome {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI(R) &kp C &kp H &kp R &kp O &kp M &kp E &kp ENTER>;
        };

        // Macro mở Discord qua hộp thoại Run
        open_discord: open_discord {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI(R) &kp D &kp I &kp S &kp C &kp O &kp R &kp D &kp ENTER>;
        };

        // Macro mở Telegram qua hộp thoại Run
        open_telegram: open_telegram {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI(R) &kp T &kp E &kp L &kp E &kp G &kp R &kp A &kp M &kp ENTER>;
        };

        // Macro tắt máy tính nhanh trên Windows (Alt + F4 -> Enter)
        shutdown_pc: shutdown_pc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT(F4) &kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Vặn núm xoay EC11: Tăng / Giảm âm lượng
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            bindings = <
                // ---- HÀNG DƯỚI ----
                &kp PSCRN          // Nút 1: Chụp ảnh màn hình (Print Screen)
                &kp LGUI(E)        // Nút 2: Mở File Explorer (Win + E)
                &open_telegram     // Nút 3: Mở Telegram
                &shutdown_pc       // Nút 4: Tắt máy tính

                // ---- HÀNG TRÊN (3 switch + 1 nút nhấn núm xoay EC11) ----
                &kp C_AL_CALC      // Nút 1: Mở ứng dụng Calculator (Máy tính)
                &open_chrome       // Nút 2: Mở Chrome
                &open_discord      // Nút 3: Mở Discord
                &bootloader        // EC11 (Nhấn xuống): Đưa mạch về chế độ nạp code
            >;
        };
    };
};
